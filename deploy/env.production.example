# Copy to deploy/.env.production and fill in. Never commit the real file.
# Full explanations: deploy/ENV-CHECKLIST.md

# --- compose ---
IMAGE=third-place-backend:local
API_DOMAIN=api.3rd-place.co.jp

# --- server ---
NODE_ENV=production
LOG_LEVEL=info

# --- database / redis (managed services) ---
DATABASE_URL=postgres://tplace:CHANGE_ME@db-host:5432/tplace?sslmode=require
REDIS_URL=rediss://default:CHANGE_ME@redis-host:6380

# --- auth ---
JWT_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_KID=k1
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# --- app gating (comma-separated; two during client rollout windows) ---
APP_KEYS=CHANGE_ME_openssl_rand_hex_24

# --- queue / janitor ---
QUEUE_PREFIX=prod
JANITOR_INTERVAL_MS=3600000
WORKER_SHUTDOWN_TIMEOUT_MS=25000
UPLOAD_MAX_ENTRY_BYTES=2147483648
UPLOAD_STUCK_AFTER_MS=1800000

# --- media / R2 ---
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_MEDIA=tplace-media-prod
STREAM_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32_same_as_worker
STREAM_TOKEN_TTL_SEC=900
MEDIA_BASE_URL=https://media.3rd-place.co.jp
