# Third Place backend — environment variables.
# Copy to .env for local development. Values marked [step N] are wired in that step;
# they are listed now so the full surface is visible from day one.

# --- Server (step 1) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# --- Database (step 3) ---
# Port 5433: the docker-compose Postgres maps to 5433 to avoid the native
# Postgres many Macs (including this one) run on 5432.
DATABASE_URL=postgres://tplace:tplace@localhost:5433/tplace

# --- Redis / job queue (step 3) ---
REDIS_URL=redis://localhost:6379

# --- Auth (step 4) ---
# JWT_SIGNING_KEY: generate with `openssl rand -hex 32`. KID identifies the key for rotation.
JWT_SIGNING_KEY=
JWT_KID=k1
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Trusted reverse-proxy hops, so req.ip is the real client behind a CDN/LB.
# Comma-separated CIDRs/IPs, or a hop count. LEAVE EMPTY when directly exposed —
# trusting an untrusted peer lets clients forge X-Forwarded-For and both evade
# and weaponize the per-IP login limiter. Never set this to "true".
TRUSTED_PROXIES=

# --- App gating (step 5) ---
# Comma-separated to allow two active keys during client rollout windows.
APP_KEYS=dev-app-key

# --- Media / object storage (steps 6-7) ---
# Local dev uses MinIO from docker-compose (S3-compatible, same code path as R2).
# For real R2: unset R2_ENDPOINT and set R2_ACCOUNT_ID instead.
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=tplace
R2_SECRET_ACCESS_KEY=tplace-secret
R2_BUCKET_MEDIA=tplace-media-dev
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_SEC=900
MEDIA_BASE_URL=http://127.0.0.1:9000/tplace-media-dev
